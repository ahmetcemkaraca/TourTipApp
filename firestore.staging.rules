rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staging environment rules - more permissive for testing
    
    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Tours collection - readable by all, writable by admins and staging testers
    match /tours/{tourId} {
      allow read: if true; // Public read in staging
      allow write: if request.auth != null && 
        (resource.data.role == 'admin' || resource.data.role == 'staging_tester');
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         resource.data.role == 'admin' ||
         resource.data.role == 'staging_tester');
      allow create: if request.auth != null;
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true; // Public read
      allow write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         resource.data.role == 'admin' ||
         resource.data.role == 'staging_tester');
    }
    
    // Analytics events - staging testers can access
    match /analytics_events/{eventId} {
      allow read, write: if request.auth != null && 
        (resource.data.role == 'admin' || 
         resource.data.role == 'staging_tester');
    }
    
    // Support tickets
    match /support_tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }
    
    // Test data collections - only for staging
    match /test_data/{document=**} {
      allow read, write: if request.auth != null && 
        (resource.data.role == 'admin' || 
         resource.data.role == 'staging_tester');
    }
    
    // Staging logs
    match /staging_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
        (resource.data.role == 'admin' || 
         resource.data.role == 'staging_tester');
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
