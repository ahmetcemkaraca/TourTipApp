# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="sk_test_YOUR_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET"

# Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Maps Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Security Configuration
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=30
SECURITY_RATE_LIMIT_REQUESTS=100
SECURITY_ENABLE_BRUTE_FORCE_PROTECTION=true
SECURITY_ENABLE_SUSPICIOUS_ACTIVITY_DETECTION=true
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_REQUIRE_SPECIAL_CHARS=true

# App Check (Security)
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY="YOUR_RECAPTCHA_SITE_KEY"
FIREBASE_APP_CHECK_DEBUG_TOKEN="YOUR_DEBUG_TOKEN"

# VAPID Keys for Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"

# Encryption Keys
ENCRYPTION_KEY="YOUR_32_BYTE_ENCRYPTION_KEY"
JWT_SECRET="YOUR_JWT_SECRET_KEY"

# Rate Limiting
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_REDIS_PREFIX="tourtrip_rate_limit"

# Analytics Configuration
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ANALYTICS_DEBUG_MODE=false

# BigQuery Configuration (for Analytics Export)
GOOGLE_CLOUD_PROJECT_ID="your-project-id"
BIGQUERY_DATASET_ID="analytics_export"
BIGQUERY_TABLE_PREFIX="events_"

# Custom Analytics Settings
ANALYTICS_DATA_RETENTION_DAYS=365
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=5000
ANALYTICS_QUEUE_MAX_SIZE=1000

# Firebase Functions Configuration (set via Firebase CLI)
# firebase functions:config:set stripe.secret_key="sk_test_YOUR_SECRET_KEY"
# firebase functions:config:set stripe.webhook_secret="whsec_YOUR_WEBHOOK_SECRET"

# =====================================
# Firebase Extensions Configuration
# =====================================

# SendGrid Email Extension
SENDGRID_API_KEY="SG.your_sendgrid_api_key"

# Mailgun Email (Alternative)
MAILGUN_API_KEY="your_mailgun_api_key"
MAILGUN_DOMAIN="your_mailgun_domain"

# Resend Email (Alternative)
RESEND_API_KEY="re_your_resend_api_key"

# Algolia Search Extension
ALGOLIA_APP_ID="your_algolia_app_id"
ALGOLIA_API_KEY="your_algolia_api_key"
ALGOLIA_SEARCH_KEY="your_algolia_search_key"

# Google Cloud Translation
GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account.json"

# BigQuery Export Configuration
BIGQUERY_EXPORT_DATASET="firestore_export"

# Bitly URL Shortener
BITLY_ACCESS_TOKEN="your_bitly_access_token"

# Twilio SMS Extension
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Image Processing Configuration
IMAGE_RESIZE_SIZES="200x200,400x400,800x800,1200x1200"
IMAGE_CONVERT_TO="webp"
IMAGE_QUALITY="80"

# Extension Feature Flags
ENABLE_STRIPE_PAYMENTS=true
ENABLE_EMAIL_EXTENSIONS=true
ENABLE_IMAGE_RESIZE=true
ENABLE_SEARCH_INDEX=true
ENABLE_TRANSLATION=true
ENABLE_BIGQUERY_EXPORT=false
ENABLE_URL_SHORTENER=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_AUDIT_LOGS=true

# =====================================
# Monitoring Configuration
# =====================================

# Monitoring Features
NEXT_PUBLIC_MONITORING_ENABLE_PERFORMANCE=true
NEXT_PUBLIC_MONITORING_ENABLE_RUM=true
NEXT_PUBLIC_MONITORING_ENABLE_ERRORS=true
NEXT_PUBLIC_MONITORING_ENABLE_CUSTOM_METRICS=true

# Data Retention (days)
MONITORING_METRIC_RETENTION_DAYS=30
MONITORING_ALERT_RETENTION_DAYS=90
MONITORING_LOG_RETENTION_DAYS=7

# Refresh Intervals (seconds)
MONITORING_DEFAULT_REFRESH_INTERVAL=30
MONITORING_REAL_TIME_INTERVAL=5

# Dashboard Limits
MONITORING_MAX_DASHBOARD_WIDGETS=20
MONITORING_MAX_METRICS_PER_QUERY=1000

# Alerting Configuration
MONITORING_ENABLE_EMAIL_ALERTS=true
MONITORING_ENABLE_SLACK_ALERTS=false
MONITORING_ENABLE_SMS_ALERTS=false
MONITORING_ENABLE_WEBHOOK_ALERTS=true

# External Monitoring Services
MONITORING_ENABLE_UPTIME_ROBOT=false
MONITORING_ENABLE_DATADOG=false
MONITORING_ENABLE_NEW_RELIC=false
MONITORING_ENABLE_SENTRY=true

# Firebase Emulator for Development
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# =====================================
# Advanced Security Configuration
# =====================================

# App Check Configuration
NEXT_PUBLIC_ADVANCED_SECURITY_APP_CHECK=true
APP_CHECK_ENFORCEMENT=unenforced

# reCAPTCHA Configuration
NEXT_PUBLIC_RECAPTCHA_V2_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY="your_recaptcha_v2_site_key"
NEXT_PUBLIC_RECAPTCHA_V3_ENABLED=true
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY="your_recaptcha_v3_site_key"
RECAPTCHA_SCORE_THRESHOLD=0.5

# reCAPTCHA Enterprise (Optional)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_ENABLED=false
RECAPTCHA_ENTERPRISE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY="your_enterprise_site_key"

# Biometric Authentication
NEXT_PUBLIC_BIOMETRIC_AUTH_ENABLED=true

# Security Monitoring
SECURITY_REAL_TIME_ALERTS=true
SECURITY_FAILED_LOGIN_THRESHOLD=10
SECURITY_SUSPICIOUS_SCORE_THRESHOLD=80
SECURITY_NEW_DEVICE_THRESHOLD=5
SECURITY_DATA_EXFIL_THRESHOLD=10485760

# Alert Channels
SECURITY_ALERT_EMAILS="security@tourtrip.app,admin@tourtrip.app"
SECURITY_ALERT_SLACK_WEBHOOK="https://hooks.slack.com/services/xxx"
SECURITY_ALERT_WEBHOOK="https://api.tourtrip.app/security/webhook"

# Automated Security Actions
SECURITY_AUTO_BLOCK_IPS=true
SECURITY_AUTO_LOCK_ACCOUNTS=true
SECURITY_AUTO_REQUIRE_MFA=true
SECURITY_AUTO_ROTATE_SESSIONS=false

# Compliance Settings
SECURITY_GDPR_ENABLED=true
SECURITY_GDPR_RETENTION_DAYS=365
SECURITY_GDPR_CONSENT_REQUIRED=true

SECURITY_KVKK_ENABLED=true
SECURITY_KVKV_RETENTION_DAYS=365
SECURITY_KVKV_EXPLICIT_CONSENT=true

# Audit Trail
SECURITY_AUDIT_TRAIL_ENABLED=true
SECURITY_AUDIT_RETENTION_DAYS=2555
SECURITY_AUDIT_IMMUTABLE=true

# Debug Tokens (Development Only)
FIREBASE_APP_CHECK_DEBUG_TOKENS="debug-token-1,debug-token-2"

# =====================================
# Performance Monitoring Configuration
# =====================================

# Firebase Performance Monitoring
NEXT_PUBLIC_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_CUSTOM_TRACES=true
NEXT_PUBLIC_NETWORK_MONITORING=true
NEXT_PUBLIC_UX_TRACKING=true

# Performance Settings
PERFORMANCE_SAMPLE_RATE=1.0
PERFORMANCE_BUDGET_TOTAL_LOAD=3000
PERFORMANCE_BUDGET_TTFB=600
PERFORMANCE_BUDGET_DOM_READY=2000

# Core Web Vitals Thresholds
PERFORMANCE_LCP_THRESHOLD=2500
PERFORMANCE_FID_THRESHOLD=100
PERFORMANCE_CLS_THRESHOLD=0.1

# Resource Monitoring
PERFORMANCE_SLOW_RESOURCE_THRESHOLD=1000
PERFORMANCE_SLOW_API_THRESHOLD=2000

# Memory Monitoring
PERFORMANCE_MEMORY_WARNING_THRESHOLD=80
PERFORMANCE_ENABLE_MEMORY_TRACKING=true

# Bundle Analysis
PERFORMANCE_BUNDLE_SIZE_LIMIT=500
PERFORMANCE_CHUNK_SIZE_LIMIT=100

# Real User Monitoring (RUM)
PERFORMANCE_ENABLE_RUM=true
PERFORMANCE_RUM_SAMPLE_RATE=0.1